{
  "extends": "@feedback/typescript-config/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@feedback/ui/*": ["../../packages/ui/src/*"],
      "@feedback/schema": ["../../packages/schema/src/index.ts"],
      "@feedback/schema/*": ["../../packages/schema/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
