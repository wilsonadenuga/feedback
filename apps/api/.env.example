# Database
DATABASE_URL=postgresql://localhost:5432/feedback?schema=public

# App
NODE_ENV=development
PORT=3000

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long-here
JWT_EXPIRATION=15
JWT_ACCESS_TOKEN_SECRET=your-super-secret-jwt-key-min-32-chars-long-here
JWT_ACCESS_TOKEN_EXPIRATION=15
JWT_REFRESH_TOKEN_SECRET=your-super-secret-jwt-key-min-32-chars-long-here
JWT_REFRESH_TOKEN_EXPIRATION=15

# Token Expiry (in minutes)
WORKSPACE_INVITE_TOKEN_EXPIRY=10080

# REDIS
REDIS_URL=redis://localhost:6379

# RESEND
RESEND_API_KEY=your-resend-api-key-here

#GOOGLE
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=