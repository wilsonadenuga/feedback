model Project {
  id           String   @id @default(uuid())
  workspace_id String
  name         String
  description  String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  workspace Workspace  @relation(fields: [workspace_id], references: [id])
  labels    Label[]
  feedbacks Feedback[]
  api_keys  ApiKey[]

  @@unique([workspace_id, name])
  @@map("projects")
}
