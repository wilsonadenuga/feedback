model Project {
  id            String   @id @default(uuid())
  owner_user_id String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  owner           User       @relation(fields: [owner_user_id], references: [id])
  project_members Member[]
  categories      Category[]
  feedbacks       Feedback[]

  @@map("projects")
}
