model MfaRecoveryCode {
  id         String    @id @default(uuid())
  user_id    String
  code_hash  String
  used_at    DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("mfa_recovery_codes")
}
