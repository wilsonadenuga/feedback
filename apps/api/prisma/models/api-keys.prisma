// API keys for external integrations (long-term access)
model ApiKey {
  id         String   @id @default(uuid())
  name       String
  key        String   @unique
  project_id String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  project Project @relation(fields: [project_id], references: [id])

  @@map("api_keys")
}
