model Token {
  id         String    @id @default(uuid())
  type       String
  value      String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())
  user_id    String?

  user             User?             @relation(fields: [user_id], references: [id])
  workspaceInvites WorkspaceInvite[]

  @@map("tokens")
}
